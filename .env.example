NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

GOOGLE_ROUTES_API_KEY=

# Server-only Google Places key. If omitted, the server-only Routes key is used.
GOOGLE_PLACES_SERVER_API_KEY=

# Server-only Supabase project URL and service-role credential.
SUPABASE_URL=
